<?xml version='1.0' standalone='yes'?>
<PLUGIN name="zfs.snapsync" author="Adnan Nashawaty" version="2026.09.18.06" icon="zfs-snapsync.png" pluginURL="https://raw.githubusercontent.com/adnanklink/zfssnapsync-unraid/main/dist/zfs.snapsync.plg" support="https://github.com/adnanklink/zfssnapsync-unraid/issues" min="6.12.0" launch="Settings/ZFSSnapSync">Plain-English ZFS snapshot scheduling, retention cleanup, and low-space protection for Unraid.
  <CHANGES>
### 2026.09.18.06 (2026-09-18)
- Install, update, and support URLs now use the renamed zfssnapsync-unraid repository.
- Align Activity and Automation controls; shorten the optional tab to SnapSync.
- Install and updates now track main; existing SnapSync clients can update normally.
- New SnapSync logo and plugin icons; optional Unraid navigation tab under Tools → Interface.
- Update SnapSync author attribution and add an optional developer support link.
- Fix indefinite Browse loading and add prominent dataset discovery status with retry.
- Align Refresh datasets and move tuning defaults to compact bottom controls.
- Standalone ZFS SnapSync identity, configuration, runtime paths and update manifest.
- Independent default snapshot prefixes and manual hold tag; no automatic import of original plugin work.
- Coordinator-owned deletion and batch journals with verified cancellation and RAM-only runtime history.
- Native local scheduled replication and Run Now with measured space approval and verified completion.
- Opt-in per-job retention anchor cleanup preserves the keep-all window and protected checkpoints.
- Testing build: native SSH, shared cleanup ownership and broader release gates remain unfinished.
- Stop original-plugin work and disable its schedules before using the same datasets; configuration is not imported.

  </CHANGES>

  <DESCRIPTION>
ZFS SnapSync adds plain-English scheduling and safe snapshot lifecycle management for Unraid. It keeps recent snapshots, consolidates older ones by day/week, and cleans up for low-space pressure using your configured prefix safeguards.
  </DESCRIPTION>

  <SUPPORT>https://github.com/adnanklink/zfssnapsync-unraid/issues</SUPPORT>

  <FILE Name="/boot/config/plugins/zfs.snapsync/zfs-snapsync-2026.09.18.06-noarch-1.txz" Min="6.12.0">
    <URL>https://raw.githubusercontent.com/adnanklink/zfssnapsync-unraid/main/dist/zfs-snapsync-2026.09.18.06-noarch-1.txz</URL>
    <MD5>f0aa10e7252db003f51649f248c76a08</MD5>
  </FILE>

  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -euo pipefail

PKG_DIR="/boot/config/plugins/zfs.snapsync"
PKG_FILE="zfs-snapsync-2026.09.18.06-noarch-1.txz"
PKG_PATH="${PKG_DIR}/${PKG_FILE}"
PKG_URL="https://raw.githubusercontent.com/adnanklink/zfssnapsync-unraid/main/dist/${PKG_FILE}"
PKG_MD5="f0aa10e7252db003f51649f248c76a08"
PKG_NAME="zfs-snapsync"

if command -v upgradepkg >/dev/null 2>&1; then
  UPGRADEPKG="$(command -v upgradepkg)"
elif [[ -x /sbin/upgradepkg ]]; then
  UPGRADEPKG="/sbin/upgradepkg"
elif [[ -x /usr/sbin/upgradepkg ]]; then
  UPGRADEPKG="/usr/sbin/upgradepkg"
else
  echo "ERROR: upgradepkg not found on system." >&2
  exit 1
fi

mkdir -p "${PKG_DIR}"

download_pkg() {
  if command -v wget >/dev/null 2>&1; then
    wget --no-cache -O "${PKG_PATH}" "${PKG_URL}"
  else
    curl -fsSL "${PKG_URL}" -o "${PKG_PATH}"
  fi
}

verify_md5() {
  if command -v md5sum >/dev/null 2>&1; then
    echo "${PKG_MD5}  ${PKG_PATH}" | md5sum -c -
  else
    [[ "$(md5 -q "${PKG_PATH}")" == "${PKG_MD5}" ]]
  fi
}

if [[ ! -f "${PKG_PATH}" ]]; then
  download_pkg
fi

if ! verify_md5; then
  rm -f "${PKG_PATH}"
  download_pkg
  verify_md5
fi

"${UPGRADEPKG}" --install-new "${PKG_PATH}"

if ! ls -1 /var/log/packages 2>/dev/null | grep -q "^${PKG_NAME}"; then
  echo "Package registration missing after install; retrying with --reinstall." >&2
  "${UPGRADEPKG}" --install-new --reinstall "${PKG_PATH}"
fi

if ! ls -1 /var/log/packages 2>/dev/null | grep -q "^${PKG_NAME}"; then
  echo "ERROR: ${PKG_NAME} is still missing from /var/log/packages after install." >&2
  exit 1
fi

if [ -x /usr/local/emhttp/plugins/zfs.snapsync/scripts/repair-permissions.sh ]; then
  /usr/local/emhttp/plugins/zfs.snapsync/scripts/repair-permissions.sh || true
fi

if [ -x /usr/local/emhttp/plugins/zfs.snapsync/scripts/sync-cron.sh ]; then
  /usr/local/emhttp/plugins/zfs.snapsync/scripts/sync-cron.sh || true
fi
    ]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
set -euo pipefail

if [ -x /usr/local/emhttp/plugins/zfs.snapsync/scripts/pre-remove.sh ]; then
  /usr/local/emhttp/plugins/zfs.snapsync/scripts/pre-remove.sh || true
fi

removepkg zfs-snapsync >/dev/null 2>&1 || true

# Fallback cleanup for installs that missed package DB registration.
rm -f /usr/local/sbin/zfs_snapsync
rm -rf /usr/local/emhttp/plugins/zfs.snapsync

rm -f /boot/config/plugins/zfs.snapsync/zfs-snapsync-*-noarch-1.txz
rm -f /boot/config/plugins/zfs.snapsync/zfs-snapsync-*-noarch-1.txz.md5
rmdir /boot/config/plugins/zfs.snapsync 2>/dev/null || true
    ]]></INLINE>
  </FILE>
</PLUGIN>
